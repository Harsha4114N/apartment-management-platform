# ═══════════════════════════════════════════════════════════════════════
# NexusGate — Backend Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the production values.
# NEVER commit the actual .env file to version control.
#
# ═══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# The deployed URL of the frontend (used for CORS and Socket.io)
# Examples: https://nexusgate.vercel.app | https://nexusgate.netlify.app
CLIENT_URL=https://your-frontend.vercel.app

# ── MongoDB (Database) ────────────────────────────────────────────────
# MongoDB Atlas connection string with credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apartmentDB?appName=Cluster0

# ── JWT Authentication ────────────────────────────────────────────────
# Generate a strong random secret:  openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ── Razorpay (Payment Gateway) ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudinary (Image & Receipt Uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (WhatsApp Notifications) ───────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MY_PHONE_NUMBER=+919999999999

# ═══════════════════════════════════════════════════════════════════════
# Frontend Environment Variables (for reference — set on Vercel dashboard)
# ═══════════════════════════════════════════════════════════════════════
#
# VITE_API_URL        — The full URL of THIS backend server
#                       Example: https://nexusgate-api.onrender.com
#                       The frontend falls back to http://localhost:5000 when
#                       this variable is not set (local development).
#
# VITE_RAZORPAY_KEY_ID — Razorpay key ID for the frontend checkout flow
#                        Must match RAZORPAY_KEY_ID in the backend .env
