# ═══════════════════════════════════════════════════════════════
# Apartment Management Platform — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for your production environment.
# NEVER commit the actual .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── Server ──
PORT=
NODE_ENV=production
CLIENT_URL=

# ── MongoDB ──
MONGO_URI=

# ── JWT Authentication ──
JWT_SECRET=

# ── Razorpay (Payment Gateway) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary (Image Uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Twilio (WhatsApp Notifications) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MY_PHONE_NUMBER=

# ── Vite Frontend Environment Variables (set on Vercel/Netlify dashboard) ──
# VITE_API_BASE=
# VITE_RAZORPAY_KEY_ID=
