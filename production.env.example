# ═══════════════════════════════════════════════════════════════════════
# NexusGate — Apartment Management Platform
# Master Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to the appropriate location and rename to .env:
#   - Backend:  server/.env
#   - Frontend: Set these in your Vercel/Railway dashboard
#
# NEVER commit the actual .env files to version control.
#
# ═══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# The deployed URL of the frontend (used for CORS and Socket.io)
# Example: https://nexusgate.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# ── MongoDB (Database) ────────────────────────────────────────────────
# Use MongoDB Atlas connection string:
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apartmentDB?appName=Cluster0

# ── JWT Authentication ────────────────────────────────────────────────
# Generate a strong random secret:  openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ── Razorpay (Payment Gateway) ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudinary (Image & Receipt Uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (WhatsApp Notifications) ───────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MY_PHONE_NUMBER=+919999999999

# ═══════════════════════════════════════════════════════════════════════
# Frontend Environment Variables (set in Vercel / Netlify dashboard)
# ═══════════════════════════════════════════════════════════════════════
#
# VITE_API_URL       — The deployed backend URL (used by axios for all API calls)
#                      Example: https://nexusgate-api.onrender.com
#                      Defaults to http://localhost:5000 when not set
#
# VITE_RAZORPAY_KEY_ID — Razorpay key ID for the frontend checkout
#                         Must match RAZORPAY_KEY_ID above
#                         Defaults to rzp_test_TI2QbuBDpf0R2f when not set
